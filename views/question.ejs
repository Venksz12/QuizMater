<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuizMaster - Quiz</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* Quiz wrapper container [cite: 1036-1043] */
        .quiz-wrapper { 
            background: #ffffff; 
            border-radius: 20px; 
            padding: 40px 50px; 
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2); 
            max-width: 900px; 
            width: 100%; 
            animation: fadeIn 1s ease-in-out; /* cite: 1044 */
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .quiz-title {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            color: #102770;
            margin-bottom: 30px;
            position: relative;
        }

        /* Underline decoration for the title  */
        .quiz-title::after {
            content: "";
            display: block;
            width: 80px;
            height: 4px;
            background-color: #66a6ff;
            margin: 10px auto 0;
            border-radius: 2px;
        }

        /* Question box with hover effect [cite: 1072-1084] */
        .question-box { 
            background-color: #f4f8ff; 
            border-radius: 12px; 
            padding: 25px; 
            margin-bottom: 25px; 
            transition: transform 0.2s ease; 
            border: 1px solid #d9e6f2; 
        }

        .question-box:hover {
            transform: scale(1.01);
            box-shadow: 0 12px 20px rgba(102, 166, 255, 0.2);
        }

        /* Option sets [cite: 1091-1117] */
        .optn-set {
            margin-bottom: 10px;
            background-color: #ffffff;
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
            transition: all 0.3s ease-in-out;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .optn-set:hover {
            color: #007bff;
            background-color: #eef5ff;
            border-color: #007bff;
        }

        .form-check-input {
            accent-color: #007bff;
            transform: scale(1.2);
            margin: 0;
        }

        /* Submit button styling [cite: 1118-1137] */
        .btn-submit { 
            background: linear-gradient(to right, #102770, #0056b3); 
            color: white; 
            width: 100%; 
            padding: 14px; 
            border-radius: 12px; 
            font-weight: bold; 
            font-size: 18px;
            border: none; 
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
        }

        .btn-submit:hover {
            background: linear-gradient(to right, #0056b3, #102770);
            transform: scale(1.02);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body>
    <div class="quiz-wrapper">
        <form action="/submit" method="post" id="quizForm">
            <input type="hidden" name="topic" value="<%= topic %>">
            <input type="hidden" name="subject" value="<%= subject %>">
            
            <h2 class="quiz-title">
                <i class="fas fa-brain me-2"></i>
                <%= subject.toUpperCase() %> - <%= topic.toUpperCase() %>
            </h2>
            
            <% if (locals.ques && ques.length > 0) { %>
                <% ques.forEach((question, index) => { %>
                    <div class="question-box qset">
                        <p class="fw-bold mb-3"><%= index + 1 %>. <%= question.question %></p>
                        
                        <input type="hidden" name="answer" value="<%= question.correctAnswer %>">
                        <input type="hidden" name="question" value="<%= question.question %>">
                        
                        <% question.options.forEach((opt) => { %>
                            <label class="optn-set w-100">
                                <input class="form-check-input" type="radio" name="q<%= index %>" value="<%= opt %>" required>
                                <span><%= opt %></span>
                            </label>
                        <% }) %>
                    </div>
                <% }) %>
                <button type="submit" class="btn-submit" id="btn-quiz">Submit Your Answers</button>
            <% } else { %>
                <div class="alert alert-warning text-center">No questions found for this topic.</div>
                <div class="text-center">
                    <a href="/subjects" class="btn btn-secondary px-4">Go Back to Subjects</a>
                </div>
            <% } %>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#quizForm").submit(function (event) {
                let allAnswered = true;
                $(".qset").each(function () {
                    if ($(this).find("input[type='radio']:checked").length === 0) {
                        allAnswered = false;
                    }
                });

                if (!allAnswered) {
                    alert("Please answer all questions before submitting!");
                    event.preventDefault();
                }
            });
        });
    </script>
</body>
</html>