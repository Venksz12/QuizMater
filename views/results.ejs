<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuizMaster - Results</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* Main results card styling [cite: 1258-1265] */
        .res-card { 
            background: #fff; 
            border-radius: 20px; 
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15); 
            padding: 40px; 
            max-width: 800px; 
            width: 100%; 
            animation: fadeIn 0.8s ease-in-out; /* cite: 1266 */
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Score display styling [cite: 1277-1286] */
        .score-display {
            text-align: center;
            font-size: 32px;
            font-weight: bold;
            color: #102770;
            margin-bottom: 30px;
            border-bottom: 3px solid #66a6ff;
            display: inline-block;
            padding-bottom: 10px;
        }

        /* Review item styling [cite: 1290-1302] */
        .key-item { 
            background: #f4f8ff; 
            border: 1px solid #dbeaff; 
            border-radius: 12px; 
            padding: 20px; 
            margin-bottom: 20px; 
            text-align: left; 
            transition: 0.3s ease; 
        }

        .key-item:hover {
            box-shadow: 0 8px 20px rgba(102, 166, 255, 0.2);
            transform: scale(1.01);
        }

        .key-item h6 { color: #102770; font-weight: bold; } /* cite: 1304 */

        .crt { color: #28a745; font-weight: 600; margin-bottom: 5px; } /* cite: 1308-1311 */
        .wrg { color: #dc3545; font-weight: 600; } /* cite: 1313-1316 */

        /* Perfect score message [cite: 1317-1323] */
        .perfect-msg {
            text-align: center;
            color: #28a745;
            font-size: 20px;
            font-weight: bold;
            margin: 40px 0 20px;
        }

        /* Navigation buttons [cite: 1330-1347] */
        .btn-nav {
            background: linear-gradient(to right, #102770, #0056b3);
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            text-decoration: none;
            display: inline-block;
        }

        .btn-nav:hover {
            background: linear-gradient(to right, #0056b3, #102770);
            transform: scale(1.05);
            color: white;
        }
    </style>
</head>
<body>
    <div class="res-card text-center m-auto mt-5">
        <h2 class="score-display">
            <i class="fas fa-award me-2"></i>Your Score: <%= score %>
        </h2>

        <div class="mt-4">
            <% if (locals.key && key.length > 0) { %>
                <h4 class="text-start mb-3" style="color: #102770;">
                    <i class="fas fa-list-check me-2"></i>Detailed Report:
                </h4>
                <% key.forEach(ele => { %>
                    <div class="key-item">
                        <h6><i class="fas fa-question-circle me-2"></i>Q) <%= ele.q %></h6>
                        <p class="crt"><i class="fas fa-check-circle me-2"></i>Correct Answer: <%= ele.a %></p>
                        <p class="wrg"><i class="fas fa-times-circle me-2"></i>Your Answer: <%= ele.w %></p>
                    </div>
                <% }) %>
            <% } else { %>
                <h4 class="perfect-msg">
                    <i class="fas fa-star me-2"></i>Wow!! Your Every Answer is Correct!
                </h4>
            <% } %>
        </div>

        <div class="d-flex gap-3 justify-content-center mt-4">
            <a href="/leaderboard" class="btn-nav">
                <i class="fas fa-trophy me-1"></i> View Leaderboard
            </a>
            <a href="/subjects" class="btn-nav">
                <i class="fas fa-book me-1"></i> Back to Subjects
            </a>
        </div>
    </div>
</body>
</html>